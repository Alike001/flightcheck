{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "vitest.config.ts",
    "apps/**/*.test.ts",
    "apps/**/test/**/*.ts",
    "packages/**/*.test.ts",
    "packages/**/test/**/*.ts"
  ]
}
