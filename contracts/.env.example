# Public network endpoints. Replace them only if you use another trusted provider.
OG_MAINNET_RPC_URL=https://evmrpc.0g.ai
OG_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai

# Deployment safety boundary. Use 16661 for 0G mainnet and 16602 for Galileo.
FLIGHTCHECK_EXPECTED_CHAIN_ID=16661

# Never commit a populated value. Copy this file to .env before deployment.
FLIGHTCHECK_DEPLOYER_PRIVATE_KEY=
