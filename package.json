{
  "name": "flightcheck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "check": "pnpm typecheck && pnpm test && pnpm contracts:check",
    "contracts:build": "forge build --root contracts",
    "contracts:check": "pnpm contracts:fmt && pnpm contracts:build && pnpm contracts:test && pnpm contracts:snapshot:check",
    "contracts:fmt": "forge fmt --root contracts --check",
    "contracts:setup": "git clone --depth 1 --branch v1.16.2 https://github.com/foundry-rs/forge-std.git contracts/lib/forge-std",
    "contracts:snapshot": "forge snapshot --root contracts --no-match-test 'testFuzz|invariant_' --snap contracts/.gas-snapshot",
    "contracts:snapshot:check": "forge snapshot --root contracts --no-match-test 'testFuzz|invariant_' --check contracts/.gas-snapshot",
    "contracts:test": "forge test --root contracts",
    "schema:check": "pnpm --filter @flightcheck/report schema:check",
    "schema:write": "pnpm --filter @flightcheck/report schema:write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --recursive typecheck && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
